{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/admin.js": {
      "maxDuration": 60,
      "includeFiles": "api/_fonts/**"
    },
    "api/manuel.js": {
      "maxDuration": 30,
      "includeFiles": "api/_fonts/**"
    }
  }
}